{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardia-rama.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit *)",
      "Bash(npm run dev)",
      "Bash(npx eslint *)",
      "Bash(npx jest *)",
      "Bash(journalctl *)",
      "Bash(ss *)"
    ]
  }
}
