# === Supabase (Base de Datos) ===
# Obtener en: Project Settings -> API
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# === Telegram (Notificaciones) ===
# Obtener vía @BotFather y @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Username del bot SIN el @ (lo da @BotFather al crearlo, ej: omar_dev_bot).
# Solo se usa para construir el deep-link del botón "💬 Responder ahora"
# en notificaciones de lead (Tarea 28.1). Si lo dejas vacío, el botón se omite
# y siguen apareciendo "Ver conversación" + "Marcar contactado".
TELEGRAM_BOT_USERNAME=

# === Admin Panel ===
# Autenticación vía Supabase magic-link + tabla user_roles. Allowlist opcional
# (emails separados por coma). Vacío = cualquier usuario con rol en user_roles.
ADMIN_ALLOWED_EMAILS=hernandezreyomar@gmail.com
CRON_SECRET=

# === Email (Resend — gratis para envíos a tu propio dominio) ===
RESEND_API_KEY=

# === CRM (Notion — gratis para uso personal) ===
# Obtener en: https://www.notion.so/my-integrations
NOTION_API_KEY=
# ID de la base de datos (parte de la URL entre la barra y el signo de interrogación)
NOTION_DATABASE_ID=

# === Cal.com (Agendado) ===
# URLs públicas de tus eventos
NEXT_PUBLIC_CALCOM_INTERVIEW_URL=https://cal.com/omar/entrevista-30min
NEXT_PUBLIC_CALCOM_CONSULT_URL=https://cal.com/omar/consulta-15min

# === Contacto público ===
NEXT_PUBLIC_WHATSAPP_NUMBER=573219052878
NEXT_PUBLIC_SITE_URL=https://omarhernandez.dev

# === Auto-submit (Tarea 29.10) ===
DEV_TO_API_KEY=
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=


# === Métodos de Cobro (Tarea 18.1) ===
# PayPal: link PayPal.Me — https://paypal.com/paypalme
NEXT_PUBLIC_PAYMENT_PAYPAL_URL=https://paypal.me/tu-handle
# Wompi: link de checkout reutilizable — https://comercios.wompi.co
NEXT_PUBLIC_PAYMENT_WOMPI_URL=https://checkout.wompi.co/l/xxxxxx
# Nequi QR: ruta pública al PNG del QR Bre-B (sirve para Nequi y demás bancos CO)
NEXT_PUBLIC_PAYMENT_NEQUI_QR=/payments/nequi-qr.png

# === SEO y Webmaster Tools ===
# Google Search Console - Código de verificación (meta tag)
# Obtener en: https://search.google.com/search-console
# Código actual: 0I_RGGL_z4LoRDMnAk_Wfbxw0H1ROZJgTDxZbuq4ThY
NEXT_PUBLIC_GSC_VERIFICATION=0I_RGGL_z4LoRDMnAk_Wfbxw0H1ROZJgTDxZbuq4ThY

# Bing Webmaster Tools - Código de verificación (meta tag)
# Obtener en: https://www.bing.com/webmasters
NEXT_PUBLIC_BING_VERIFICATION=

# IndexNow API Key - Generar con: node -e "console.log(crypto.randomUUID())"
# Usado para notificar a Bing/Yandex sobre nuevas páginas
# El archivo de verificación debe estar en: public/{INDEXNOW_API_KEY}.txt
INDEXNOW_API_KEY=
