# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Capturas y videos de Cypress (T-23): se regeneran en cada corrida y se
# suben como artefacto de CI — no son código fuente, no se versionan.
/cypress/screenshots/
/cypress/videos/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Windows artifacts when copying files from Windows to WSL (mark of the web)
*:Zone.Identifier

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
src/lib/chatbot/data/_omar_inputs.md
secrets/
!secrets/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
mis-claves-chatbot.txt*

# Claude Code: el estado local (memoria, tareas, settings.local.json) no se
# versiona, pero las skills y agentes del proyecto sí, para que cualquier
# sesión —local o en la nube— diseñe con el mismo criterio.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/settings.json

# Coordinación entre IAs concurrentes (sección O del documento)
.claim-lock
.ia-bitacora.log

# Impeccable: estado por desarrollador y cachés (lo compartido sí se versiona)
.impeccable/config.local.json
.impeccable/hook.cache.json
supabase/.temp/
